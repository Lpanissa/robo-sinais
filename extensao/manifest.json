{
  "manifest_version": 3,
  "name": "Robô de Sinais - Piloto",
  "version": "1.20.1",
  "description": "Opera os sinais do Robô de Sinais na Olymp Trade e manda o histórico para o app.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://data-api.binance.vision/*",
    "https://api.twelvedata.com/*",
    "https://fyxksvydxwvygjebanno.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://olymptrade.com/*"
      ],
      "js": [
        "motor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
