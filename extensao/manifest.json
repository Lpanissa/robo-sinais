{
  "manifest_version": 3,
  "name": "Robô de Sinais - Piloto",
  "version": "1.26.3",
  "description": "Opera na Olymp Trade usando o gráfico da própria Olymp e manda o histórico para o app.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://fyxksvydxwvygjebanno.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://olymptrade.com/*"
      ],
      "js": [
        "olymp-escuta.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://olymptrade.com/*"
      ],
      "js": [
        "motor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}